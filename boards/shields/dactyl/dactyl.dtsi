#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    default_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Dactyl Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        // Key positions follow the 76 bindings in dactyl.keymap.
        // Values are width, height, X, Y, rotation, rotation-X, rotation-Y
        // in centi-keyunits/centi-degrees.
        keys =
            <&key_physical_attrs 100 100    0    0 (-1200) 0 0>
            , <&key_physical_attrs 100 100  105    0 (-800) 0 0>
            , <&key_physical_attrs 100 100  210    0 (-400) 0 0>
            , <&key_physical_attrs 100 100  315    0 0 0 0>
            , <&key_physical_attrs 100 100  420    0 400 0 0>
            , <&key_physical_attrs 100 100  525    0 800 0 0>
            , <&key_physical_attrs 100 100  900    0 800 0 0>
            , <&key_physical_attrs 100 100 1005    0 400 0 0>
            , <&key_physical_attrs 100 100 1110    0 0 0 0>
            , <&key_physical_attrs 100 100 1215    0 (-400) 0 0>
            , <&key_physical_attrs 100 100 1320    0 (-800) 0 0>
            , <&key_physical_attrs 100 100 1425    0 (-1200) 0 0>

            , <&key_physical_attrs 100 100    0  120 (-1200) 0 0>
            , <&key_physical_attrs 100 100  105  120 (-800) 0 0>
            , <&key_physical_attrs 100 100  210  120 (-400) 0 0>
            , <&key_physical_attrs 100 100  315  120 0 0 0>
            , <&key_physical_attrs 100 100  420  120 400 0 0>
            , <&key_physical_attrs 100 100  525  120 800 0 0>
            , <&key_physical_attrs 100 100  900  120 800 0 0>
            , <&key_physical_attrs 100 100 1005  120 400 0 0>
            , <&key_physical_attrs 100 100 1110  120 0 0 0>
            , <&key_physical_attrs 100 100 1215  120 (-400) 0 0>
            , <&key_physical_attrs 100 100 1320  120 (-800) 0 0>
            , <&key_physical_attrs 100 100 1425  120 (-1200) 0 0>

            , <&key_physical_attrs 100 100    0  200 0 0 0>
            , <&key_physical_attrs 100 100  100  200 0 0 0>
            , <&key_physical_attrs 100 100  200  200 0 0 0>
            , <&key_physical_attrs 100 100  300  200 0 0 0>
            , <&key_physical_attrs 100 100  400  200 0 0 0>
            , <&key_physical_attrs 100 100  500  200 0 0 0>
            , <&key_physical_attrs 100 100  900  200 0 0 0>
            , <&key_physical_attrs 100 100 1000  200 0 0 0>
            , <&key_physical_attrs 100 100 1100  200 0 0 0>
            , <&key_physical_attrs 100 100 1200  200 0 0 0>
            , <&key_physical_attrs 100 100 1300  200 0 0 0>
            , <&key_physical_attrs 100 100 1400  200 0 0 0>

            , <&key_physical_attrs 100 100    0  300 0 0 0>
            , <&key_physical_attrs 100 100  100  300 0 0 0>
            , <&key_physical_attrs 100 100  200  300 0 0 0>
            , <&key_physical_attrs 100 100  300  300 0 0 0>
            , <&key_physical_attrs 100 100  400  300 0 0 0>
            , <&key_physical_attrs 100 100  500  300 0 0 0>
            , <&key_physical_attrs 100 100  900  300 0 0 0>
            , <&key_physical_attrs 100 100 1000  300 0 0 0>
            , <&key_physical_attrs 100 100 1100  300 0 0 0>
            , <&key_physical_attrs 100 100 1200  300 0 0 0>
            , <&key_physical_attrs 100 100 1300  300 0 0 0>
            , <&key_physical_attrs 100 100 1400  300 0 0 0>

            , <&key_physical_attrs 100 100    0  400 0 0 0>
            , <&key_physical_attrs 100 100  100  400 0 0 0>
            , <&key_physical_attrs 100 100  200  400 0 0 0>
            , <&key_physical_attrs 100 100  300  400 0 0 0>
            , <&key_physical_attrs 100 100  400  400 0 0 0>
            , <&key_physical_attrs 100 100  500  400 0 0 0>
            , <&key_physical_attrs 100 100  900  400 0 0 0>
            , <&key_physical_attrs 100 100 1000  400 0 0 0>
            , <&key_physical_attrs 100 100 1100  400 0 0 0>
            , <&key_physical_attrs 100 100 1200  400 0 0 0>
            , <&key_physical_attrs 100 100 1300  400 0 0 0>
            , <&key_physical_attrs 100 100 1400  400 0 0 0>

            , <&key_physical_attrs 100 100  200  550 0 0 0>
            , <&key_physical_attrs 100 100  300  550 0 0 0>
            , <&key_physical_attrs 100 100  400  550 0 0 0>
            , <&key_physical_attrs 100 100  500  550 0 0 0>
            , <&key_physical_attrs 100 100  900  550 0 0 0>
            , <&key_physical_attrs 100 100 1000  550 0 0 0>
            , <&key_physical_attrs 100 100 1100  550 0 0 0>
            , <&key_physical_attrs 100 100 1200  550 0 0 0>

            , <&key_physical_attrs 100 100  400  700 0 0 0>
            , <&key_physical_attrs 100 100  500  700 0 0 0>
            , <&key_physical_attrs 100 100  900  700 0 0 0>
            , <&key_physical_attrs 100 100 1000  700 0 0 0>

            , <&key_physical_attrs 100 100  400  850 0 0 0>
            , <&key_physical_attrs 100 100  500  850 0 0 0>
            , <&key_physical_attrs 100 100  900  850 0 0 0>
            , <&key_physical_attrs 100 100 1000  850 0 0 0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>; // 6 per half
        rows = <8>;     // 8 rows

        map = <
            // Left Half (Physical columns C6 -> C1)         // Right Half (Physical columns C1 -> C6)
            RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)  RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)  RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
                            RC(5,3) RC(5,2) RC(5,1) RC(5,0)  RC(5,6) RC(5,7) RC(5,8) RC(5,9)
                                            RC(6,1) RC(6,0)  RC(6,6) RC(6,7)
                                            RC(7,1) RC(7,0)  RC(7,6) RC(7,7)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row"; // Change to "row2col" if your diodes face the columns

        col-gpios
            = <&pro_micro 10 (GPIO_ACTIVE_HIGH)> // C1
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH)> // C2
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH)> // C3
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH)> // C4
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH)> // C5
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH)> // C6
            ;

        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R1
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R2
            , <&pro_micro 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R3
            , <&pro_micro 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R4
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R5
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R6
            , <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R7
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R8
            ;
    };
};
